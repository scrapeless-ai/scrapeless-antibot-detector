{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.0.1",
  "version_name": "1.0.1",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",

  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https:; frame-src 'none'; base-uri 'none'; form-action 'none'; object-src 'self'"
  },

  "permissions": [
    "storage",
    "favicon",
    "activeTab",
    "tabs",
    "webRequest",
    "cookies",
    "downloads",
    "alarms"
  ],

  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "background": {
    "service_worker": "src/entry/worker.js"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "src/probe/property-predicate.js",
        "src/probe/hook-recovery-guard.js",
        "src/probe/global-signal-watcher.js",
        "src/entry/page-probe.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "src/foundation/telemetry.js",
        "src/foundation/runtime-policy.js",
        "src/foundation/text-codec.js",
        "src/foundation/web-address.js",
        "src/scanning/finding-metrics.js",
        "src/foundation/extension-gateway.js",
        "src/scanning/compiled-pattern-pool.js",
        "src/foundation/extension-store.js",
        "src/scanning/evidence-scorer.js",
        "src/scanning/method-plan.js",
        "src/scanning/page-snapshot.js",
        "src/scanning/signal-matcher.js",
        "src/scanning/probe-batch-relay.js",
        "src/scanning/scan-engine.js",
        "src/console/preferences/runtime-service.js",
        "src/entry/page-agent.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],

  "action": {
    "default_popup": "console.html",
    "default_title": "Scrapeless: anti-bot detector",
    "default_icon": {
      "16": "brand/toolbar-16.png",
      "32": "brand/toolbar-32.png",
      "48": "brand/toolbar-48.png",
      "128": "brand/toolbar-128.png"
    }
  },

  "icons": {
    "16": "brand/toolbar-16.png",
    "32": "brand/toolbar-32.png",
    "48": "brand/toolbar-48.png",
    "128": "brand/toolbar-128.png"
  }
}
